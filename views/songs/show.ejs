<%- include('../partials/header') %>

<h1> <%= song.title %> </h1>

<p> <%= song.artist_name %> </p>

<p>登録日:<%= song.created_at.toLocaleDateString('ja-JP') %></p>

<a href = '/songs/<%= song.id %>/edit'>編集する</a>

<form action="/songs/<%= song.id %>/delete" method="POST" onsubmit="return confirm('この曲を削除しますか？')">
  <button type="submit">削除する</button>
</form>

<a href="/songs">曲一覧に戻る</a>

<%- include('../partials/footer') %>

